amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["golangci-fmt"] = Builtins.golangci_lint_fmt
    ["golangci-lint"] = (Builtins.golangci_lint) {
        depends = List("golangci-fmt")
    }
}

local goFiles = List("**/*.go", "go.mod", "go.sum")

local goTest = new Step {
    glob = goFiles
    check = "make test"
    depends = List("golangci-lint")
}

local goBuild = new Step {
    glob = goFiles
    check = "make build"
    depends = List("go-test")
}

local allChecks = (linters) {
    ["go-test"] = goTest
    ["go-build"] = goBuild
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = allChecks
    }
    ["check"] { 
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
